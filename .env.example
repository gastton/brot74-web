# Copiar a .env y completar con valores propios. Ver README.md para el detalle de cada variable.

DATABASE_URL=
# Misma base sin el pooler (pgbouncer) — la usan los comandos de Prisma
# Migrate. En Neon: mismo connection string sacando "-pooler" del host, o
# copiala con "Connection pooling" apagado en el modal de conexión.
DIRECT_URL=

ADMIN_PASSWORD=
JWT_SECRET=

BLOB_READ_WRITE_TOKEN=

# Mercado Pago (Checkout Pro, API de Orders). Solo servidor: nunca NEXT_PUBLIC_.
# En dev, el Access Token de la cuenta vendedora de prueba ("APP_USR-…").
MP_ACCESS_TOKEN=
# "Firma secreta" de Webhooks en el panel de la aplicación de MP.
MP_WEBHOOK_SECRET=

NEXT_PUBLIC_ALIAS=
NEXT_PUBLIC_CVU=
NEXT_PUBLIC_CUIT=
NEXT_PUBLIC_TITULAR=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
