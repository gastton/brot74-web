generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  price       Int
  weight      String   @default("")
  ingredients String   @default("")
  imageUrl    String   @default("")
  focalX      Int      @default(50)
  focalY      Int      @default(50)
  availableDays String @default("")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks     ProductStock[]
  orderItems OrderItem[]
}

model DeliverySlot {
  id           Int      @id @default(autoincrement())
  date         DateTime
  dayLabel     String
  deliveryMode String   @default("pickup") // "pickup" | "delivery" | "both"
  pickupTime   String   @default("")
  location     String   @default("")
  imageUrl     String   @default("")
  imageFocalX  Int      @default(50)
  imageFocalY  Int      @default(50)
  orderCutoff  DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  stocks ProductStock[]
  orders Order[]
}

model ProductStock {
  id             Int  @id @default(autoincrement())
  productId      Int
  deliverySlotId Int
  totalStock     Int  @default(0)
  reservedStock  Int  @default(0)

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  deliverySlot DeliverySlot @relation(fields: [deliverySlotId], references: [id], onDelete: Cascade)

  @@unique([productId, deliverySlotId])
}

model Order {
  id              Int      @id @default(autoincrement())
  customerName    String
  customerPhone   String
  customerAddress String   @default("")
  deliverySlotId  Int
  status          String   @default("pending")
  mpPreferenceId  String   @default("")
  mpPaymentId     String   @default("")
  total           Int
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deliverySlot DeliverySlot @relation(fields: [deliverySlotId], references: [id])
  items        OrderItem[]
}

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}
